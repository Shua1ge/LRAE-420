<?xml version="1.0"?>
<package format="2">
  <name>lrae_go2</name>
  <version>0.1.0</version>
  <description>
    LRAE exploration stack adapted to the Unitree Go2 + simulated Livox MID-360
    in ROS 1 Noetic / Gazebo Classic.  The robot, sensor and RL policy come from
    go2_description; this package only provides the sensor-frame adapter and the
    LRAE launch wiring.
  </description>
  <maintainer email="t1an@example.com">t1an</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <exec_depend>fitplane</exec_depend>
  <exec_depend>lrae_planner</exec_depend>
  <exec_depend>gen_local_goal</exec_depend>
  <exec_depend>local_planner</exec_depend>
  <exec_depend>go2_description</exec_depend>

  <export>
    <build_type>catkin</build_type>
  </export>
</package>
