Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Cell Size: 10
      Color: 120; 120; 120
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 400
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/PointCloud2
      Enabled: true
      Name: bag_map
      Topic: /cloud_pcd
      Queue Size: 10
      Style: Points
      Size (Pixels): 2
      Size (m): 0.03
      Alpha: 1
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Intensity Bounds: true
      Value: true
    - Class: rviz/TF
      Enabled: false
      Name: TF
      Show Arrows: false
      Show Axes: false
      Show Names: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/PublishPoint
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 80
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.8
      Yaw: 2.4
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
