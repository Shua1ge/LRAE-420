Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Cell Size: 10
      Color: 160; 160; 160
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 200
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: false
      Show Axes: false
      Show Names: false
      Value: true
    - Class: rviz/RobotModel
      Enabled: true
      Name: Go2
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz/Map
      Alpha: 0.7
      Enabled: true
      Name: globalMap
      Topic: /globalMap
      Color Scheme: map
      Draw Behind: true
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: exporation_path
      Topic: /exporation_path
      Color: 0; 220; 0
      Line Style: Lines
      Line Width: 0.06
      Value: true
    - Class: rviz/Path
      Enabled: true
      Name: our_local_path
      Topic: /lrae_local_path
      Color: 0; 220; 255
      Line Style: Lines
      Line Width: 0.05
      Value: true
    - Class: rviz/Path
      Enabled: false
      Name: bag_path_reference
      Topic: /path
      Color: 255; 0; 255
      Line Style: Lines
      Line Width: 0.04
      Value: false
    - Class: rviz/PointCloud2
      Enabled: true
      Name: mid360_world
      Topic: /mid360_world
      Style: Points
      Size (m): 0.03
      Color Transformer: AxisColor
      Axis: Z
      Value: true
    - Class: rviz/PointCloud2
      Enabled: true
      Name: traversability
      Topic: /local_traversibility_ponit_cloud
      Style: Points
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Name: centroids
      Topic: /centroids
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/PublishPoint
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 12
      Focal Point:
        X: 136
        Y: -177
        Z: 0.4
      Name: Current View
      Pitch: 0.55
      Yaw: 2.4
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
